---
import Layout from "../../components/Layout.astro";
import { supabase } from "../../utils/database";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  throw new Error("No framework id provided");
}

// Fetch pet data from Supabase if connection is set up
let framework;
if (supabase) {
  const { data, error } = await supabase
    .from("frameworks")
    .select("*")
    .eq("id", id)
    .single();
  framework = data ? data : null;
  if (error || !framework) {
    console.error(error);
    throw new Error("No framework found");
  }
}

const formattedDate = framework?.created_at
  ? new Date(framework.created_at).toISOString().split('T')[0]
  : 'N/A';
---

<Layout title={`${framework?.name} | Frameworks`}>
  <article class="border-b pb-14 border-neutral-600">
    <header
      class="flex flex-wrap items-center justify-between pb-2 mb-8 border-b"
    >
      <h1 class="mb-8 text-4xl font-bold">Privileges and Rewards</h1>
    </header>

    <p class="py-6 text-xl">You have {framework?.likes} reward points as of {formattedDate}.</p>

  </article>
</Layout>
