---
import Layout from "../../components/Layout.astro";
import { supabase } from "../../utils/database";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  throw new Error("No framework id provided");
}

// Fetch pet data from Supabase if connection is set up
let framework;
if (supabase) {
  const { data, error } = await supabase
    .from("frameworks")
    .select("*")
    .eq("id", id)
    .single();
  framework = data ? data : null;
  if (error || !framework) {
    console.error(error);
    throw new Error("No framework found");
  }
}

const formattedDate = framework?.created_at
  ? new Date(framework.created_at).toISOString().split('T')[0]
  : 'N/A';
const formattedTime = framework?.created_at
  ? new Date(framework.created_at).toISOString().split('T')[1]
  : 'N/A';
const hour = formattedTime.split(':')[0];
const minute = formattedTime.split(':')[1];
const modifiedDate = formattedDate.replace('-', '年').replace('-', '月');
---

<Layout title="累積積分親身見證樂壇盛事">
  <article class="border-b pb-14 border-neutral-600">
    <header
      class="flex flex-wrap items-center justify-between pb-2 mb-8 border-b"
    >
      <h1 class="mb-8 text-4xl font-bold">積分紀錄</h1>
    </header>

    <p class="py-6 text-xl">直至{modifiedDate}號{hour}時{minute}分，你擁有{framework?.points}積分。</p>

  </article>
</Layout>
