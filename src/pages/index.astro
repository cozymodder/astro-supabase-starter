---
import { getEntry } from "astro:content";
import Alert from "../components/Alert.astro";
import Guide from "../components/Guide.astro";
import Layout from "../components/Layout.astro";
import TableRow from "../components/TableRow.astro";
import { supabase } from "../utils/database";

export const prerender = false;

let name = '';
let email = '';
let submissionStatus = '';

const handleSubmit = async (event) => {
  event.preventDefault();
  submissionStatus = ''; // Reset status

  const { data, error } = await supabase
    .from('your_table_name') // Replace with your table name
    .select('email') // Fetch the email based on the name
    .eq('name', name) // Match the name entered
    .single(); // Get a single record

  if (error) {
    submissionStatus = 'Error fetching data: ' + error.message;
  } else if (data) {
    email = data.email; // Set the fetched email
    submissionStatus = 'Email fetched successfully!';
  } else {
    submissionStatus = 'No email found for the provided name.';
  }
};
---

<Layout title="Web Frameworks">
  {
    supabase ? (
      frameworks ? (
        <>
          <h1>Get Email by Name</h1>
		  <form on:submit={handleSubmit}>
			<label>
			  Name:
			  <input type="text" bind:value={name} required />
			</label>
			<button type="submit">Fetch Email</button>
		  </form>

		  {email && <p>Email: {email}</p>}
		  {submissionStatus && <p>{submissionStatus}</p>}
		  </>
		)
  }
</Layout>